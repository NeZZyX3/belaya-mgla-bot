# belaya-mgla-bot: thin RU layer on top of the official Autopilot bot image.
# Upstream keeps shipping fixes/features; we only add what «Белая мгла» needs.
ARG UPSTREAM_IMAGE=registry.gitlab.com/batazor/autopilot/bot:latest
FROM ${UPSTREAM_IMAGE}

# RU module overlays (games/wos/ru/...): region fixes + modules disabled for RU.
COPY ru/overlay/games/ /app/games/

# adb shim (Docker Desktop on Windows: start the adb server without hanging).
COPY --chmod=0755 ru/runtime/adb /app/.venv/bin/adb

# redis-py unix-socket fix, auto-loaded by every Python process via .pth.
COPY ru/runtime/belaya_redis_compat.py ru/runtime/belaya_redis_compat.pth /app/.venv/lib/python3.13/site-packages/

# Always use the RU module catalog (Russian OCR + RU overlays) for game "wos".
COPY ru/runtime/belaya_force_catalog.py ru/runtime/belaya_force_catalog.pth /app/.venv/lib/python3.13/site-packages/

# Fail the build if the fixes do not load in this upstream version.
RUN /app/.venv/bin/python -c "import redis.connection as c, belaya_redis_compat; \
cls = getattr(c, 'AbstractConnection', None) or c.Connection; \
f = getattr(cls, '_enable_maintenance_notifications', None); \
assert f is None or getattr(f, '_belaya_patch', False), 'redis patch not applied'; \
print('belaya-mgla-bot redis fix OK')"

# Catalog hook check is advisory: a missing env/import must not block the image.
RUN /app/.venv/bin/python -c "import services as s; print('active catalog:', s.get_active_module_catalog())" || true

LABEL org.opencontainers.image.source="https://github.com/NeZZyX3/belaya-mgla-bot" \
      org.opencontainers.image.description="Autopilot + RU layer for «Белая мгла»" \
      org.opencontainers.image.licenses="MIT"
